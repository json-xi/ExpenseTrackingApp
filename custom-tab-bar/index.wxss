.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  padding: 10rpx 0 calc(10rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 28rpx rgba(36, 51, 48, 0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #7a8884;
}

.tab-item.active {
  color: #2a8a7a;
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
}

.tab-text {
  font-size: 26rpx;
  line-height: 1.2;
}

.tab-item:active {
  opacity: 0.7;
}
