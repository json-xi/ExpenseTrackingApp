.label {
  display: block;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.content {
  width: 100%;
  height: 260rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  border: 1rpx solid var(--line);
  background: var(--surface);
}

.content-placeholder {
  font-size: 28rpx;
  color: var(--muted);
}

.counter {
  display: block;
  margin: 12rpx 0 48rpx;
  font-size: 22rpx;
  text-align: right;
}

.contact {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--line);
  background: var(--surface);
}

.contact-placeholder {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.submit-btn {
  margin-top: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0;
  line-height: 1;
  background: var(--text);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 0;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn-hover {
  opacity: 0.85;
}

.tip {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  text-align: center;
}
