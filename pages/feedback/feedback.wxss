.label {
  display: block;
  font-size: 24rpx;
  margin: 8rpx 8rpx 16rpx;
}

.content {
  width: 100%;
  height: 280rpx;
  padding: 28rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: var(--surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.content-placeholder {
  font-size: 28rpx;
  color: var(--muted);
}

.counter {
  display: block;
  margin: 12rpx 8rpx 40rpx;
  font-size: 22rpx;
  text-align: right;
}

.contact {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  background: var(--surface);
  border-radius: 999rpx;
  box-shadow: var(--shadow);
}

.contact-placeholder {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.submit-btn {
  margin-top: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0;
  line-height: 1;
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 999rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn-hover {
  opacity: 0.85;
}

.tip {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  text-align: center;
}
