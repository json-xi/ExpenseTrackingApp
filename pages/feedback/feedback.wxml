<view class="page">
  <text class="label muted">你的想法</text>
  <textarea
    class="content"
    value="{{content}}"
    placeholder="遇到的问题、想要的功能，都可以告诉我们"
    placeholder-class="content-placeholder"
    maxlength="300"
    bindinput="onContentInput"
  />
  <text class="counter muted">{{content.length}}/300</text>

  <text class="label muted">联系方式（可选）</text>
  <input
    class="contact"
    value="{{contact}}"
    placeholder="微信号或邮箱，方便回复你"
    placeholder-class="contact-placeholder"
    maxlength="40"
    bindinput="onContactInput"
  />

  <button class="submit-btn" bindtap="onSubmit" hover-class="submit-btn-hover">提交</button>

  <text class="tip muted">反馈会先保存在本机，接入服务后自动上报</text>
</view>
