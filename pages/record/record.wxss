.record-page {
  padding-bottom: 984rpx;
}

.record-page.pad-folded {
  padding-bottom: 280rpx;
}

.empty {
  padding-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.7;
}

.session {
  margin-top: 8rpx;
  padding-top: 16rpx;
  padding-bottom: 8rpx;
}

.session-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0 16rpx;
  font-size: 24rpx;
}

.session-link {
  font-size: 24rpx;
  flex-shrink: 0;
  padding-left: 24rpx;
  color: var(--text);
}

.session-link:active {
  opacity: 0.55;
}

.record-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.record-row + .record-row {
  border-top: 1rpx solid var(--line);
}

.record-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.record-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.record-cat {
  font-size: 30rpx;
}

.record-note {
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 420rpx;
}

.pad {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: var(--surface);
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(36, 51, 48, 0.08);
  padding: 8rpx 20rpx calc(12rpx + var(--tab-bar-h) + env(safe-area-inset-bottom));
}

.pad-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}

.pad-toggle-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
  flex-shrink: 0;
  opacity: 0.45;
}

.pad-toggle-text {
  height: 44rpx;
  display: flex;
  align-items: center;
  max-width: 560rpx;
}

.pad-toggle-text text {
  font-size: 24rpx;
  line-height: 1;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pad-toggle:active {
  opacity: 0.6;
}

.pad.collapsed {
  padding-top: 0;
}

.pad.collapsed .pad-toggle {
  height: 72rpx;
  margin-bottom: 0;
}

.pad.collapsed .pad-toggle-text {
  height: 72rpx;
}

.pad-book {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 52rpx;
  padding: 0 20rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: var(--text);
  background: var(--fill);
  border-radius: 999rpx;
}

.pad-book:active {
  opacity: 0.7;
}

.pad-book-arrow {
  color: var(--muted);
}

.pad-tools {
  display: flex;
  gap: 12rpx;
}

.type-switch {
  flex: 0 0 200rpx;
  display: flex;
  height: 64rpx;
  padding: 4rpx;
  background: var(--fill);
  border-radius: 999rpx;
}

.type-opt {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--muted);
  border-radius: 999rpx;
}

.type-opt.active {
  color: #fff;
  background: var(--brand);
  font-weight: 500;
}

.tool {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text);
  background: var(--fill);
  border-radius: 999rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool:active {
  opacity: 0.7;
}

.tool-date {
  gap: 8rpx;
}

.tool-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.tool-note {
  gap: 8rpx;
}

.tool-note.has-note {
  color: var(--text);
}

.pad-amount {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0;
}

.pad-amount-value {
  max-width: 100%;
  font-size: 56rpx;
  font-weight: 500;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pad-amount-value.placeholder {
  color: #d4cfc4;
}

.pad-cats {
  display: flex;
  padding: 4rpx 0 8rpx;
}

.cat {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 10rpx 0 12rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.cat-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat .cat-icon {
  width: 36rpx;
  height: 36rpx;
}

.cat.active {
  color: var(--text);
}

.cat.active .cat-icon-wrap {
  background: #fff;
  box-shadow: inset 0 0 0 2rpx var(--brand);
}

.cat:active {
  opacity: 0.7;
}

.more-dots {
  gap: 6rpx;
}

.more-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--muted);
}

.cat-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: calc(var(--tab-bar-h) + env(safe-area-inset-bottom));
  z-index: 40;
  background: rgba(42, 39, 35, 0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.cat-sheet {
  width: 100%;
  background: var(--surface);
  padding: 28rpx 24rpx 32rpx;
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -12rpx 48rpx rgba(36, 51, 48, 0.1);
}

.cat-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 20rpx;
}

.cat-sheet-title {
  font-size: 30rpx;
  font-weight: 500;
}

.cat-sheet-close {
  font-size: 26rpx;
  color: var(--muted);
  padding: 8rpx 4rpx;
}

.cat-sheet-grid {
  display: flex;
  flex-wrap: wrap;
}

.cat-sheet-grid .cat {
  width: 25%;
}

.pad-keys {
  display: flex;
  flex-wrap: wrap;
  padding: 0 0 12rpx;
}

.key {
  width: 25%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text);
  background: var(--fill);
  border: 8rpx solid var(--surface);
  border-radius: 28rpx;
  box-sizing: border-box;
}

.key:active {
  background: #e8e2d6;
}

.key-del-icon {
  width: 44rpx;
  height: 44rpx;
}

.key-save {
  font-size: 28rpx;
  color: #fff;
  background: var(--brand);
}

.key-save:active {
  opacity: 0.88;
  background: var(--brand);
}

.note-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(42, 39, 35, 0.4);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 80rpx 40rpx 48rpx;
}

.note-mask.lifted {
  align-items: flex-end;
  padding-top: 24rpx;
}

.note-sheet {
  width: 100%;
  background: var(--surface);
  padding: 36rpx 32rpx 28rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.note-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.note-area {
  width: 100%;
  height: 180rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background: var(--fill);
  border-radius: var(--radius);
}

.note-placeholder {
  color: var(--muted);
}

.note-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

.note-btn {
  min-width: 128rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--muted);
  border-radius: 999rpx;
}

.note-btn-ok {
  color: #fff;
  background: var(--brand);
}

.note-btn:active {
  opacity: 0.7;
}
