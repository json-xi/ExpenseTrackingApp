.hint {
  display: block;
  margin: 0 8rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.head {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.list {
  padding: 8rpx 28rpx;
  margin-bottom: 32rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
}

.row + .row {
  border-top: 1rpx solid var(--line);
}

.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.row-cat {
  font-size: 30rpx;
}

.row-meta {
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-amount {
  flex-shrink: 0;
  font-size: 30rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text);
  background: var(--surface);
  border-radius: 999rpx;
  box-shadow: var(--shadow);
}

.btn-primary {
  color: #fff;
  background: var(--brand);
}

.btn:active {
  opacity: 0.75;
}
