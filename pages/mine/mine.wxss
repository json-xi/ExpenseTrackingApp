.profile {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 24rpx 0 48rpx;
}

.avatar-btn {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
  border: none;
  background: transparent;
  overflow: visible;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-btn:active {
  opacity: 0.8;
}

.avatar {
  display: block;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #f1f1f1;
}

/* 右下角角标，提示头像可点击更换 */
.avatar-edit {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  background: var(--text);
  border: 3rpx solid var(--bg);
}

.avatar-edit-icon {
  width: 22rpx;
  height: 22rpx;
}

.profile-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname-input {
  height: 52rpx;
  line-height: 52rpx;
  font-size: 34rpx;
  font-weight: 500;
}

.nickname-placeholder {
  height: 52rpx;
  line-height: 52rpx;
  font-size: 34rpx;
  font-weight: 400;
  color: var(--muted);
}

.profile-hint {
  font-size: 22rpx;
}

.stat-bar {
  display: flex;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 16rpx;
}

.backup-hint {
  display: block;
  margin-bottom: 40rpx;
  font-size: 22rpx;
  text-align: center;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 28rpx 0;
}

.stat-cell + .stat-cell {
  border-left: 1rpx solid var(--line);
}

.stat-value {
  font-size: 34rpx;
  font-weight: 500;
}

.stat-label {
  font-size: 22rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  font-size: 30rpx;
  border-bottom: 1rpx solid var(--line);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
}

.menu-item:active {
  opacity: 0.55;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
}

.arrow {
  font-size: 32rpx;
}

.logout-wrap {
  margin-top: 72rpx;
}

.logout {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #c0392b;
  border: 1rpx solid var(--line);
  background: var(--surface);
}

.logout:active {
  opacity: 0.7;
}

.logout-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  text-align: center;
}
