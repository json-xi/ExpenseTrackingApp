.profile-card {
  padding: 32rpx 28rpx 8rpx;
}

.profile {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 8rpx 0 32rpx;
}

.avatar-btn {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
  border: none;
  background: transparent;
  overflow: visible;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-btn:active {
  opacity: 0.8;
}

.avatar {
  display: block;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: var(--fill);
}

.avatar-edit {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  background: var(--brand);
  border: 4rpx solid var(--surface);
}

.avatar-edit-icon {
  width: 22rpx;
  height: 22rpx;
}

.profile-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname-input {
  height: 52rpx;
  line-height: 52rpx;
  font-size: 36rpx;
  font-weight: 500;
}

.nickname-placeholder {
  height: 52rpx;
  line-height: 52rpx;
  font-size: 34rpx;
  font-weight: 400;
  color: var(--muted);
}

.profile-hint {
  font-size: 22rpx;
}

.stat-bar {
  display: flex;
  border-top: 1rpx solid var(--line);
}

.backup-hint {
  display: block;
  margin: 20rpx 8rpx 24rpx;
  font-size: 22rpx;
  text-align: center;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 28rpx 0;
}

.stat-cell + .stat-cell {
  border-left: 1rpx solid var(--line);
}

.stat-value {
  font-size: 34rpx;
  font-weight: 500;
}

.stat-label {
  font-size: 22rpx;
}

.menu {
  padding: 4rpx 8rpx 4rpx 20rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 16rpx 28rpx 8rpx;
  font-size: 30rpx;
}

.menu-item + .menu-item {
  border-top: 1rpx solid var(--line);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon {
  width: 32rpx;
  height: 32rpx;
}

.menu-icon-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--brand);
}

.menu-item:active {
  opacity: 0.55;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
}

.arrow {
  font-size: 32rpx;
}

.logout-wrap {
  margin-top: 48rpx;
}

.logout {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--warn);
  background: var(--surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.logout:active {
  opacity: 0.7;
}

.logout-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  text-align: center;
}
