<view class="page">
  <view class="search-bar">
    <image class="icon" src="/assets/icons/search.png" mode="aspectFit" />
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="分类、备注、金额或日期"
      placeholder-class="search-placeholder"
      confirm-type="search"
      focus
      bindinput="onInput"
    />
    <image class="clear" wx:if="{{keyword}}" src="/assets/icons/close.png" mode="aspectFit" bindtap="onClear" />
  </view>

  <view wx:if="{{!keyword}}" class="tip muted">
    <image class="empty-icon" src="/assets/icons/search.png" mode="aspectFit" />
    <text>试试输入「餐饮」「打车」或「2026-09」</text>
  </view>

  <block wx:else>
    <view class="result-head">
      <text class="muted">共 {{records.length}} 笔</text>
      <text class="muted amount" wx:if="{{records.length > 0}}">
        支 ¥{{expenseText}} · 收 ¥{{incomeText}}
      </text>
    </view>

    <view wx:if="{{records.length === 0}}" class="tip muted">
      <image class="empty-icon" src="/assets/icons/empty.png" mode="aspectFit" />
      <text>没有匹配的记录</text>
    </view>

    <view class="record" wx:for="{{records}}" wx:key="id">
      <view class="record-left">
        <image class="cat-icon" src="{{item.icon}}" mode="aspectFit" />
        <view class="record-meta">
          <text class="record-cat">{{item.categoryName}}</text>
          <text class="record-note muted">
            {{item.date}}<text wx:if="{{item.note}}"> · {{item.note}}</text>
          </text>
        </view>
      </view>
      <text class="record-amount amount {{item.type === 'income' ? 'income' : ''}}">
        {{item.sign}}¥{{item.amountText}}
      </text>
      <image
        class="delete-icon"
        src="/assets/icons/trash.png"
        mode="aspectFit"
        data-id="{{item.id}}"
        catchtap="onDeleteRecord"
      />
    </view>
  </block>
</view>
