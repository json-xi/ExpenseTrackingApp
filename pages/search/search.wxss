.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 80rpx;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
  background: var(--surface);
  border-radius: 999rpx;
  box-shadow: var(--shadow);
}

.icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

.search-placeholder {
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.clear {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.tip {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
}

.empty-icon {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.5;
}

.card .tip {
  padding: 48rpx 0;
}

.result-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 20rpx 4rpx 12rpx;
  font-size: 24rpx;
}

.record {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.record + .record {
  border-top: 1rpx solid var(--line);
}

.record-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.record-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.record-cat {
  font-size: 30rpx;
}

.record-note {
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 440rpx;
}

