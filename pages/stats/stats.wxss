.stats-page {
  padding-bottom: 380rpx;
}

.stats-page.dock-folded {
  padding-bottom: 260rpx;
}

.overview {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 40rpx 32rpx 8rpx;
  background: var(--brand);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.book-chip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 16rpx;
  padding: 6rpx 20rpx;
  background: rgba(247, 243, 236, 0.14);
  border-radius: 999rpx;
}

.book-chip:active {
  opacity: 0.7;
}

.book-chip-name {
  font-size: 22rpx;
  color: #f7f3ec;
}

.book-chip-arrow {
  font-size: 24rpx;
  color: rgba(247, 243, 236, 0.55);
}

.overview-label {
  font-size: 24rpx;
  color: rgba(247, 243, 236, 0.52);
}

.overview-value {
  margin-top: 16rpx;
  font-size: 72rpx;
  font-weight: 500;
  color: #f7f3ec;
  line-height: 1.15;
}

.overview-hint {
  font-size: 22rpx;
  margin-bottom: 28rpx;
  color: rgba(247, 243, 236, 0.45);
}

.pair {
  display: flex;
  width: 100%;
  border-top: 1rpx solid rgba(247, 243, 236, 0.1);
}

.pair-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 28rpx 0;
}

.pair-item + .pair-item {
  border-left: 1rpx solid rgba(247, 243, 236, 0.1);
}

.pair-label {
  font-size: 22rpx;
  color: rgba(247, 243, 236, 0.45);
}

.pair-value {
  font-size: 32rpx;
  font-weight: 500;
  color: #f7f3ec;
}

.overview .income {
  color: #9ad4b8;
}

.overview .expense {
  color: #e8a598;
}

.block {
  margin-bottom: 24rpx;
  padding-top: 12rpx;
  padding-bottom: 16rpx;
}

.block-title {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
}

.block-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 64rpx;
  padding: 4rpx 0 12rpx;
}

.block-head .block-title {
  flex: 1;
  min-width: 0;
}

.block-head:active {
  opacity: 0.55;
}

.block-head.plain:active {
  opacity: 1;
}

.toggle {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 16rpx 0 18rpx;
  margin-left: 16rpx;
  font-size: 22rpx;
  line-height: 1;
  color: var(--muted);
  background: var(--fill);
  border-radius: 999rpx;
  gap: 4rpx;
}

.toggle-icon {
  width: 22rpx;
  height: 22rpx;
}

.more {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--muted);
}

.more:active {
  opacity: 0.55;
}

.advice-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
}

.advice-item + .advice-item {
  border-top: 1rpx solid var(--line);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  flex-shrink: 0;
  background: var(--muted);
}

.dot-warn {
  background: var(--warn);
}

.dot-good {
  background: var(--income);
}

.advice-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.65;
}

.empty {
  padding: 56rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
}

.empty-icon {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.7;
}

.day-group + .day-group {
  margin-top: 8rpx;
}

.day-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 16rpx 0 4rpx;
}

.day-label {
  font-size: 24rpx;
  color: var(--muted);
}

.day-sum {
  font-size: 22rpx;
}

.record,
.month-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.record + .record,
.month-row + .month-row {
  border-top: 1rpx solid var(--line);
}

.month-row:active {
  opacity: 0.55;
}

.record-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.record-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.record-cat {
  font-size: 30rpx;
}

.record-note {
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 420rpx;
}

.month-sum {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.tabs {
  display: flex;
  gap: 12rpx;
  margin: 8rpx 0 28rpx;
}

.tab {
  font-size: 24rpx;
  color: var(--muted);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: transparent;
}

.tab.active {
  color: var(--text);
  background: var(--fill);
}

.stat-row {
  margin-bottom: 28rpx;
}

.stat-row:last-child {
  margin-bottom: 8rpx;
}

.stat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.stat-name-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.cat-badge-sm {
  width: 48rpx;
  height: 48rpx;
}

.cat-badge-sm .cat-icon {
  width: 26rpx;
  height: 26rpx;
}

.stat-name {
  font-size: 28rpx;
}

.stat-meta {
  font-size: 22rpx;
}

.bar-track {
  height: 12rpx;
  background: var(--fill);
  overflow: hidden;
  border-radius: 999rpx;
}

.bar-fill {
  height: 100%;
  background: var(--brand);
  border-radius: 999rpx;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 4rpx 16rpx calc(12rpx + var(--tab-bar-h) + env(safe-area-inset-bottom));
  background: var(--surface);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 28rpx rgba(36, 51, 48, 0.06);
}

.dock-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 44rpx;
}

.dock-toggle-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.45;
}

.dock-toggle-text {
  font-size: 24rpx;
  color: var(--muted);
}

.dock-toggle:active {
  opacity: 0.6;
}

.dock-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 4rpx;
}

.period-picker {
  flex: 1;
  min-width: 0;
}

.scope-switch {
  display: flex;
  flex-shrink: 0;
  padding: 4rpx;
  background: var(--fill);
  border-radius: 999rpx;
}

.scope {
  min-width: 64rpx;
  padding: 12rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
  border-radius: 999rpx;
}

.scope.active {
  color: #fff;
  background: var(--brand);
}

.search-btn {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--fill);
  border-radius: 50%;
}

.search-btn:active {
  opacity: 0.7;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
}

.nav {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text);
  background: var(--fill);
  border-radius: 50%;
}

.nav.disabled {
  color: #d4cfc4;
  background: transparent;
  pointer-events: none;
}

.period-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 64rpx;
  padding: 0 8rpx;
}

.period-inner:active {
  opacity: 0.55;
}

.period-text {
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}
