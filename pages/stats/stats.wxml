<view class="page stats-page">
  <view class="overview">
    <text class="overview-label muted">{{overviewLabel}} 总览</text>
    <text class="overview-value amount">¥{{expenseText}}</text>
    <text class="overview-hint muted">支出</text>
    <view class="pair">
      <view class="pair-item">
        <text class="muted">收入</text>
        <text class="pair-value amount income">¥{{incomeText}}</text>
      </view>
      <view class="pair-item">
        <text class="muted">结余</text>
        <text class="pair-value amount {{balance >= 0 ? 'income' : ''}}">{{balancePrefix}}¥{{balanceAbs}}</text>
      </view>
    </view>
  </view>

  <view class="block" wx:if="{{advice.length > 0}}">
    <view class="block-head" bindtap="onToggleAdvice">
      <text class="block-title muted">建议 · {{advice.length}} 条</text>
      <view class="toggle">
        <text>{{adviceOpen ? '收起' : '展开'}}</text>
        <image class="toggle-icon" src="{{adviceOpen ? '/assets/icons/chevron-up.png' : '/assets/icons/chevron-down.png'}}" mode="aspectFit" />
      </view>
    </view>
    <block wx:if="{{adviceOpen}}">
      <view class="advice-item" wx:for="{{advice}}" wx:key="text">
        <view class="dot dot-{{item.tone}}"></view>
        <text class="advice-text">{{item.text}}</text>
      </view>
    </block>
  </view>

  <view class="block">
    <view class="block-head {{listCollapsible ? '' : 'plain'}}" bindtap="onToggleList">
      <text class="block-title muted">
        {{listTitle}}<text wx:if="{{listCountText}}"> · {{listCountText}}</text>
      </text>
      <view class="toggle" wx:if="{{listCollapsible}}">
        <text>{{listExpanded ? '收起' : '展开'}}</text>
        <image class="toggle-icon" src="{{listExpanded ? '/assets/icons/chevron-up.png' : '/assets/icons/chevron-down.png'}}" mode="aspectFit" />
      </view>
    </view>

    <block wx:if="{{scope === 'year'}}">
      <view wx:if="{{monthRows.length === 0}}" class="empty muted">
        <image class="empty-icon" src="/assets/icons/empty.png" mode="aspectFit" />
        <text>这一年还没有记录</text>
      </view>
      <view
        class="month-row"
        wx:for="{{monthRows}}"
        wx:key="month"
        data-month="{{item.month}}"
        bindtap="onTapMonth"
      >
        <view class="record-left">
          <text class="record-cat">{{item.label}}</text>
          <text class="record-note muted">{{item.count}} 笔</text>
        </view>
        <view class="month-sum">
          <text class="amount">支 ¥{{item.expenseText}}</text>
          <text class="amount muted">收 ¥{{item.incomeText}}</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{groups.length === 0}}" class="empty muted">
        <image class="empty-icon" src="/assets/icons/empty.png" mode="aspectFit" />
        <text>{{emptyText}}</text>
      </view>
      <view class="day-group" wx:for="{{groups}}" wx:key="date">
        <view class="day-head" wx:if="{{showGroupHead}}">
          <text class="day-label">{{item.label}}</text>
          <text class="day-sum muted amount">
            <text wx:if="{{item.expense > 0}}">支 ¥{{item.expenseText}}</text>
            <text wx:if="{{item.expense > 0 && item.income > 0}}"> · </text>
            <text wx:if="{{item.income > 0}}">收 ¥{{item.incomeText}}</text>
          </text>
        </view>
        <view class="record" wx:for="{{item.items}}" wx:for-item="rec" wx:key="id">
          <view class="record-left">
            <image class="cat-icon" src="{{rec.icon}}" mode="aspectFit" />
            <view class="record-meta">
              <text class="record-cat">{{rec.categoryName}}</text>
              <text class="record-note muted" wx:if="{{rec.note}}">{{rec.note}}</text>
            </view>
          </view>
          <text class="record-amount amount {{rec.type === 'income' ? 'income' : ''}}">
            {{rec.sign}}¥{{rec.amountText}}
          </text>
          <image
            class="delete-icon"
            src="/assets/icons/trash.png"
            mode="aspectFit"
            data-id="{{rec.id}}"
            catchtap="onDeleteRecord"
          />
        </view>
      </view>
    </block>

    <view class="more" wx:if="{{listCollapsible && !listExpanded}}" bindtap="onToggleList">
      展开全部 {{listCountText}}
    </view>
  </view>

  <view class="block" wx:if="{{stats.length > 0}}">
    <view class="tabs">
      <text
        class="tab {{statType === 'expense' ? 'active' : ''}}"
        data-type="expense"
        bindtap="onSwitchStat"
      >支出构成</text>
      <text
        class="tab {{statType === 'income' ? 'active' : ''}}"
        data-type="income"
        bindtap="onSwitchStat"
      >收入构成</text>
    </view>
    <view class="stat-row" wx:for="{{stats}}" wx:key="id">
      <view class="stat-top">
        <view class="stat-name-wrap">
          <image class="cat-icon" src="{{item.icon}}" mode="aspectFit" />
          <text class="stat-name">{{item.name}}</text>
        </view>
        <text class="stat-meta amount muted">¥{{item.amountText}} · {{item.percent}}%</text>
      </view>
      <view class="bar-track">
        <view class="bar-fill" style="width: {{item.percent}}%;"></view>
      </view>
    </view>
  </view>

  <view class="dock">
    <view class="period-bar">
      <view class="nav" bindtap="onPrevPeriod">‹</view>
      <picker
        class="period-picker"
        mode="date"
        fields="{{scope}}"
        value="{{period}}"
        end="{{today}}"
        bindchange="onPickPeriod"
      >
        <view class="period-inner">
          <text class="period-text">{{periodLabel}}</text>
          <image class="calendar-icon" src="/assets/icons/calendar.png" mode="aspectFit" />
        </view>
      </picker>
      <view class="nav {{canNext ? '' : 'disabled'}}" bindtap="onNextPeriod">›</view>
    </view>

    <view class="dock-row">
      <view class="scope-switch">
        <view
          class="scope {{scope === 'day' ? 'active' : ''}}"
          data-scope="day"
          bindtap="onSwitchScope"
        >天</view>
        <view
          class="scope {{scope === 'month' ? 'active' : ''}}"
          data-scope="month"
          bindtap="onSwitchScope"
        >月</view>
        <view
          class="scope {{scope === 'year' ? 'active' : ''}}"
          data-scope="year"
          bindtap="onSwitchScope"
        >年</view>
      </view>
      <view class="dock-actions">
        <view class="pill" bindtap="onOpenSearch">
          <image class="search-icon" src="/assets/icons/search.png" mode="aspectFit" />
          <text class="pill-text muted">搜索</text>
        </view>
      </view>
    </view>
  </view>

</view>
